#################################
#    Classes
#################################

## la311:Location
la311:Location rdf:type owl:Class ;
	rdfs:label "Location" .

## la311:ServiceRequest
la311:ServiceRequest rdf:type owl:Class ;
	rdfs:label "Service Request" .

## la311:Organization
la311:Organization rdf:type owl:Class ;
	rdfs:label "Organization" ;
	rdfs:subClassOf la311:Agent .

## la311:AnonymousPerson
la311:AnonymousPerson rdf:type owl:Class ;
	rdfs:label "Anonymous Person" ;
	rdfs:subClassOf la311:Agent .

## la311:Service
la311:Service rdf:type owl:Class ;
	rdfs:label "Service" .

## la311:AdministrativeRegion
la311:AdministrativeRegion rdf:type owl:Class ;
	rdfs:label "Administrative Region" .

## la311:Agent
la311:Agent rdf:type owl:Class ;
	rdfs:label "Agent" .

